{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Django backend",
			"type": "shell",
			"command": "python",
			"args": [
				"backend/manage.py",
				"runserver"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run React frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"start"
			],
			"isBackground": true,
			"group": "build"
		}
	]
}