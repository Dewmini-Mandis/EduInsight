# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're executing on a system where you need to ignore it, uncomment:
#Pipfile.lock

# poetry
#   Similarly, poetry.lock is usually recommended to be committed.
#poetry.lock

# pdm
#   Similar to Pipfile.lock or poetry.lock, pdm.lock is usually committed.
#pdm.lock
